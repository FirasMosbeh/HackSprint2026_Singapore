# Mode selection.
#   unset  → auto: use the agent if it answers /api/health, else demo mode
#   true   → always demo (simulated results, no backend needed)
#   false  → always live (errors surface instead of falling back)
# VITE_DEMO_MODE=

# Where the agent lives. Leave empty in dev so requests go through the Vite
# proxy configured in vite.config.ts (which forwards /api to the agent).
VITE_API_URL=
